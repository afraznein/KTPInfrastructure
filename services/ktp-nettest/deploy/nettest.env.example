# /etc/ktp/nettest.env for ktp-nettest. Root-owned, mode 600: it holds the ticket secret.
# install.sh copies this into place only when the file does not exist yet, so an edited copy is kept.

# Region code. Must equal this node's key in the site's KTP_NETTEST_NODES (e.g. NY).
KTP_NETTEST_REGION=NY

# The secret the site signs run tickets with: one value for every node, equal to the site's
# KTP_NETTEST_TICKET_SECRET. The node refuses to start while this is still the placeholder
# below or is shorter than 32 characters. Compare the two ends by sha256, never by printing them.
KTP_NETTEST_TICKET_SECRET=__PLACEHOLDER_replace_with_the_shared_ticket_secret__

# Each local game instance's dod/logs, ':'-separated. Empty means the node reports busy for every
# test. Every dir here must also be bound in ktp-nettest.service.d/logdirs.conf.
KTP_NETTEST_LOG_DIRS=/home/dodserver/dod-27015/serverfiles/dod/logs:/home/dodserver/dod-27016/serverfiles/dod/logs:/home/dodserver/dod-27017/serverfiles/dod/logs:/home/dodserver/dod-27018/serverfiles/dod/logs:/home/dodserver/dod-27019/serverfiles/dod/logs

# WebRTC UDP range for the stall test (min-max). Open exactly this range in UFW.
KTP_NETTEST_UDP_PORTS=40000-40100

# HTTP listens on loopback only; nginx terminates TLS in front of it. Never open 8790.
KTP_NETTEST_BIND=127.0.0.1
KTP_NETTEST_PORT=8790

# The only site allowed to call the node (CORS) and to frame /frame (frame-ancestors).
KTP_NETTEST_ORIGIN=https://ktpleague.gg

[Unit]
Description=KTP per-region connection test node (ktp-nettest)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ktpnettest
Group=ktpnettest
WorkingDirectory=/opt/ktp-nettest
# KTP_NETTEST_REGION, KTP_NETTEST_TICKET_SECRET, KTP_NETTEST_LOG_DIRS, KTP_NETTEST_UDP_PORTS
EnvironmentFile=/etc/ktp/nettest.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5

# Reads the game logs for the live-match block (the user needs read access to each dod/logs
# dir, nothing more) and serves sockets. Never writes anywhere.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Game servers come first: the node yields CPU and memory to them.
Nice=10
MemoryMax=256M

[Install]
WantedBy=multi-user.target

[Unit]
Description=KTP support.ktpdod.com fleet status poller (one-shot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=supportweb
Group=supportweb
WorkingDirectory=/opt/support-web
EnvironmentFile=-/etc/ktp/support-web.env
ExecStart=/opt/support-web/venv/bin/python tools/run_poller.py

# Outbound UDP to the game hosts is all this needs; it never reads the game
# trees, the database, or anything it writes for the web tier beyond its own
# two files.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/var/www/support.ktpdod.com/status /var/lib/support-web

# A slow fleet must not let runs pile up on top of each other. 24 instances at a
# 2.5s timeout is ~5s worst case with the roster query; 45s is generous and
# still well inside the 60s timer interval.
TimeoutStartSec=45

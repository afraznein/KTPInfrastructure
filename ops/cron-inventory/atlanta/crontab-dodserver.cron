# KTP Game Server Cron Jobs - Atlanta Baremetal
# Monitor (every minute) - ensures crashed servers restart
*/1 * * * * /home/dodserver/dod-27015/dodserver monitor > /dev/null 2>&1
*/1 * * * * /home/dodserver/dod-27016/dodserver2 monitor > /dev/null 2>&1
*/1 * * * * /home/dodserver/dod-27017/dodserver3 monitor > /dev/null 2>&1
*/1 * * * * /home/dodserver/dod-27018/dodserver4 monitor > /dev/null 2>&1
*/1 * * * * /home/dodserver/dod-27019/dodserver5 monitor > /dev/null 2>&1

# Scheduled restart (3 AM ET daily)
0 3 * * * /home/dodserver/ktp-scheduled-restart.sh >> /home/dodserver/log/scheduled-restart.log 2>&1

* * * * * /home/dodserver/ktp-fleet-health.sh >/dev/null 2>&1

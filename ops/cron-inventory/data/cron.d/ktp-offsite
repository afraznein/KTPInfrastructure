# KTP offsite backups. The dump itself runs Sun 03:00 (/etc/cron.d/ktp-backup);
# these ship it, staggered so they never overlap it or each other.
#
# Sourcing a conf file rather than inlining the targets: cron.d has no include,
# and the scripts REFUSE to run with the variables unset. But a MISSING conf
# fails the `.` itself, so `&&` skips the script and NOTHING is logged --
# judge these legs by /var/log/ktp-offsite.log's mtime, not by its silence.
SHELL=/bin/bash
# DB dumps: one hour after the dump, small (~480 MB) and md5-verified far-side.
0 4 * * 0   root  . /etc/ktp/offsite.conf && /usr/local/bin/ktp-db-offsite.sh >> /var/log/ktp-offsite.log 2>&1
# Demos: after the DBs. Incremental after the first run -- rsync --checksum
# skips what already matches, so a weekly pass moves only the new matches.
0 5 * * 0   root  . /etc/ktp/offsite.conf && /usr/local/bin/ktp-demo-offsite.sh >> /var/log/ktp-offsite.log 2>&1
# AC replay corpus: after the demos. ENCRYPTED to public age recipients before
# it leaves, so this leg proves the bytes ARRIVED and cannot prove they decrypt
# -- the private halves are deliberately not on this host. --commit is not
# optional: without it the script dry-runs, reports OK and ships nothing.
# Recoverability is ktp-corpus-drill.sh, and it runs where a key is, not here.
0 6 * * 0   root  . /etc/ktp/offsite.conf && /usr/local/bin/ktp-corpus-offsite.sh --commit >> /var/log/ktp-offsite.log 2>&1

[Unit]
Description=KTP match reports (generate, aggregate, then sync to the website)
Documentation=file:///opt/ktp-reports/KTPInfrastructure/docs/runbooks/REPORT_PIPELINE_INSTALL.md
After=network-online.target mysql.service
Wants=network-online.target
# report_sync already retries a transient Supabase read, so a run that still
# fails is an outage or a real error, and worth a Discord alert.
OnFailure=ktp-systemd-alert@%n.service
# The journal only records exit-code; stdout/stderr go to /var/log/ktp-report-service.log, so read the cause there.

[Service]
Type=oneshot
User=ktpreports
Group=ktpreports
WorkingDirectory=/opt/ktp-reports/KTPInfrastructure

# KTP_SUPABASE_URL, KTP_SUPABASE_SECRET_KEY and KTP_SITE_REVALIDATE_SECRET.
# Only report_sync reads them; the two report_service steps are local-socket
# mysql and need no secret. KTP_SITE_REVALIDATE_SECRET is optional -- report_sync
# logs a warning and skips the site cache refresh when it is unset, it never
# fails the run.
EnvironmentFile=/etc/ktp/reports.env

# Three steps, in this order. systemd runs ExecStart lines sequentially and
# stops at the first non-zero exit, which is what we want: an aggregate built
# from a failed generate, or a sync of a failed aggregate, would publish a
# half-built season to the live site.
#
# The --since floor is the season boundary, and it is load-bearing. Everything
# before 2026-09-13 is pre-season pracc and scrim traffic with no official
# standing, and there is no official/scrim flag in the schema -- this date is
# the only thing separating them. Do not widen it to backfill; that publishes
# practice matches as league results.
# All three steps carry the SAME floor. generate's only scopes discovery; a
# report written another way (an explicit match id, a manual test) is stopped
# by aggregate's and sync's. aggregate and report_sync refuse to start without it.
ExecStart=/usr/bin/python3 -m scripts.report_service --repo . generate --since 2026-09-13
ExecStart=/usr/bin/python3 -m scripts.report_service --repo . aggregate --since 2026-09-13
ExecStart=/usr/bin/python3 -m scripts.report_sync --since 2026-09-13

# generate only revisits a match when the report schema version changes, so a
# tick with nothing new is nearly free. A full re-stamp after a schema bump is
# the slow case this bounds.
TimeoutStartSec=5400
Nice=10
IOSchedulingClass=idle

# Deliberately only NoNewPrivileges. ProtectSystem=strict was tried and
# removed: it makes the checkout read-only, so Python cannot write __pycache__
# and the unit fails on a detail unrelated to what it does. The account is
# already nologin with SELECT on only the tables it reads and INSERT on the two
# it owns, which is where the real containment is.
NoNewPrivileges=true

# scripts/verify_report_pipeline.py defaults to --log /var/log/ktp-report-service.log
# and keys its RAN check on that file's MTIME -- a durable artifact, deliberately
# not a log line. Journal-only output leaves that file absent, so the verifier
# fails every run whether or not the pipeline worked.
StandardOutput=append:/var/log/ktp-report-service.log
StandardError=append:/var/log/ktp-report-service.log

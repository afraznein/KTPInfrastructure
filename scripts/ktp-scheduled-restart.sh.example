#!/bin/bash
#
# THIS FILE IS THE SOURCE OF TRUTH for the scheduled restart. The gitignored
# scripts/ktp-scheduled-restart.sh beside it is a local working copy holding the
# live channel IDs; regenerate it FROM here, filling only the two placeholders
# below. Never the other way round, and never hand-maintain
# the two as separate lineages - that is how a fleet ends up on a third shape.
#
# The relay secret is NOT a placeholder any more: it is sourced at run time from
# /etc/ktp/discord-relay.conf, so no copy of this script ever holds it and a
# rotation cannot leave a deployed file behind on a retired value.
#
# The 2026-08-04 header claimed the opposite direction. Following it left this
# file structurally AHEAD of both the fleet and the copy it named, and left that
# copy three weeks stale on a retired relay secret.
#
# Which lineage wins, per-host blast radius, and the drift check:
# docs/runbooks/SCHEDULED_RESTART_LINEAGES.md.
# KTP Game Server Scheduled Restart Script
# Restarts all DoD game servers and sends Discord notification
#
# Usage: ktp-scheduled-restart.sh
# Cron:  0 3 * * * /home/dodserver/ktp-scheduled-restart.sh >> /home/dodserver/log/scheduled-restart.log 2>&1

# ============================================================================
# Configuration
# ============================================================================
RELAY_URL="https://discord-relay-78814186981.us-central1.run.app/reply"
EDIT_URL="https://discord-relay-78814186981.us-central1.run.app/edit"
# Relay secret lives in /etc/ktp/discord-relay.conf so a rotation reaches one file per
# host instead of five copies of this script. Sourced but never fatal: this script owns
# the 03:00 restart, which must survive a missing conf -- only Discord posting degrades.
RELAY_CONF="/etc/ktp/discord-relay.conf"
[ -r "$RELAY_CONF" ] && . "$RELAY_CONF"
if [ -z "${AUTH_SECRET:-}" ]; then
    echo "[WARN] AUTH_SECRET unset ($RELAY_CONF missing or unreadable) - Discord notification will fail; restart continues." >&2
fi

# Detect game server instances dynamically from ~/dod-* directories.
# An instance can be excluded from the restart cycle by creating a
# `.ktp-disabled` marker file in its directory — used on Chicago VPS to
# skip port 27019 (4-instance trial, disabled 2026-04-10).
PORTS=()
SKIPPED=()
for dir in ~/dod-2701*; do
    [ -d "$dir" ] || continue
    if [ -f "$dir/.ktp-disabled" ]; then
        SKIPPED+=($(basename "$dir" | sed 's/dod-//'))
        continue
    fi
    PORTS+=($(basename "$dir" | sed 's/dod-//'))
done
NUM_SERVERS=${#PORTS[@]}
if [ "$NUM_SERVERS" -eq 0 ]; then
    echo "ERROR: No dod-* directories found (or all are .ktp-disabled)"
    exit 1
fi

# The warmup instance lives outside ~/dod-*, so the glob above cannot see it and
# every leg below has to name it explicitly. Absent on the fleet, where the -d
# test fails and all warmup legs are skipped.
#
# Being invisible here is not cosmetic: the stop wait counts ALL hlds_linux, so
# an unmanaged warmup keeps the count above zero until the 30s timeout, and the
# force-kill that follows takes warmup down with `pkill -9` and never starts it
# again. That orphaned warmup 27050 on the LAN box from 2026-07-22.
WARMUP_DIR="${KTP_WARMUP_DIR:-/srv/ktpdata/warmup}"
WARMUP_EXEC="${KTP_WARMUP_EXEC:-dodserver}"
WARMUP_PRESENT=0
if [ -d "$WARMUP_DIR" ] && [ -x "$WARMUP_DIR/$WARMUP_EXEC" ] && [ ! -f "$WARMUP_DIR/.ktp-disabled" ]; then
    WARMUP_PRESENT=1
fi
# hlds_linux count to expect after the restart; the verify step compares against
# this, not NUM_SERVERS, or a healthy warmup reads as a failed instance.
EXPECTED_RUNNING=$((NUM_SERVERS + WARMUP_PRESENT))

# Discord channels (same as HLTV status)
CHANNEL_KTP="YOUR_KTP_CHANNEL_ID"          # KTP Discord
CHANNEL_EXTERNAL="YOUR_EXTERNAL_CHANNEL_ID"     # 1.3 Discord

# Detect server location from IP
SERVER_IP=$(hostname -I | awk '{print $1}')
case "$SERVER_IP" in
    74.91.121.9) SERVER_NAME="KTP - Atlanta" ;;
    74.91.126.55) SERVER_NAME="KTP - Dallas" ;;
    66.163.114.109) SERVER_NAME="KTP - Denver" ;;
    74.91.123.64) SERVER_NAME="KTPSCRIM - New York" ;;
    172.238.176.101) SERVER_NAME="KTPSCRIM - Chicago" ;;
    *) SERVER_NAME="KTP - Unknown ($SERVER_IP)" ;;
esac

# Discord embed colors (matching KTPMatchHandler)
COLOR_GREEN=65280       # 0x00FF00 - Success
COLOR_ORANGE=16750848   # 0xFFA500 - Partial success / In progress
COLOR_RED=16711680      # 0xFF0000 - Failure

# KTP emoji
KTP_EMOJI="<:KTP:1002382703020212245>"

# ============================================================================
# Helper Functions
# ============================================================================
log() {
    echo "[$(TZ='America/New_York' date '+%Y-%m-%d %H:%M:%S EST')] $1"
}

# Send Discord embed and capture message ID
send_discord_embed() {
    # No relay configured (e.g. a LAN box where provisioning blanked RELAY_URL):
    # skip cleanly rather than curl an empty URL or post to the wrong Discord.
    [ -z "$RELAY_URL" ] && return 0

    local channel_id="$1"
    local title="$2"
    local description="$3"
    local color="$4"
    local footer="$5"

    local payload=$(cat <<EOF
{
  "channelId": "$channel_id",
  "embeds": [{
    "title": "$title",
    "description": "$description",
    "color": $color,
    "footer": {
      "text": "$footer"
    }
  }]
}
EOF
)

    local response=$(curl -s -X POST "$RELAY_URL" \
        -H "X-Relay-Auth: $AUTH_SECRET" \
        -H "Content-Type: application/json" \
        -d "$payload")

    # Extract message ID from response
    echo "$response" | grep -o '"id":"[^"]*"' | head -1 | cut -d'"' -f4
}

# Edit existing Discord embed
edit_discord_embed() {
    # No relay configured (LAN neuter blanks EDIT_URL): skip, don't curl "".
    [ -z "$EDIT_URL" ] && return 0

    local channel_id="$1"
    local message_id="$2"
    local title="$3"
    local description="$4"
    local color="$5"
    local footer="$6"

    local payload=$(cat <<EOF
{
  "channelId": "$channel_id",
  "messageId": "$message_id",
  "embeds": [{
    "title": "$title",
    "description": "$description",
    "color": $color,
    "footer": {
      "text": "$footer"
    }
  }]
}
EOF
)

    curl -s -X POST "$EDIT_URL" \
        -H "X-Relay-Auth: $AUTH_SECRET" \
        -H "Content-Type: application/json" \
        -d "$payload" >/dev/null
}

# ============================================================================
# Pause Monitor Cron
# ============================================================================
# The backup lives under $HOME, never /tmp: an EXIT trap does not fire on power
# loss or a hard reboot, and /tmp is cleared on the way back up - so the monitor
# cron stays stripped with nothing left alive to report that it is missing.
MONITOR_CRON_MATCH='dodserver.*monitor'
CRON_STATE_DIR="${KTP_STATE_DIR:-$HOME/.ktp}"
CRON_BACKUP="$CRON_STATE_DIR/monitor-cron.bak"
mkdir -p "$CRON_STATE_DIR" 2>/dev/null

restore_cron() {
    log "Restoring monitor cron..."
    # An empty backup means `crontab -l` failed; installing it would delete every
    # entry, which is the outcome this whole block exists to prevent.
    if [ -s "$CRON_BACKUP" ]; then
        crontab "$CRON_BACKUP"
        rm -f "$CRON_BACKUP"
        log "Monitor cron restored"
    else
        log "WARNING: cron backup empty or missing - leaving the crontab as-is"
    fi
}

# A backup present at startup means an earlier run stripped the cron and never
# reached its trap. Append only the monitor lines back, never the whole file, so
# crontab edits made between that run and this one survive the recovery.
recover_monitor_cron() {
    [ -f "$CRON_BACKUP" ] || return 0

    local live saved
    live=$(crontab -l 2>/dev/null)
    saved=$(grep "$MONITOR_CRON_MATCH" "$CRON_BACKUP" 2>/dev/null)

    # The pause below strips EVERY matching line, so "backup has monitor entries,
    # live crontab has none" is a shape only an interrupted run leaves. An operator
    # disabling one instance leaves the rest, and correctly reads as debris here.
    if [ -n "$saved" ] && ! printf '%s\n' "$live" | grep -q "$MONITOR_CRON_MATCH"; then
        log "Interrupted run left the monitor cron stripped - recovering from $CRON_BACKUP"
        printf '%s\n%s\n' "$live" "$saved" | crontab -
        log "Monitor cron recovered"
    fi
    rm -f "$CRON_BACKUP"
}
recover_monitor_cron

log "Pausing monitor cron to prevent race condition..."
# Arm by rename so a half-written backup is never what recovery trusts, and skip
# the pause outright if it cannot be written - stripping without one is a one-way
# door, and a monitor cron left running is the far cheaper failure.
if crontab -l > "$CRON_BACKUP.partial" 2>/dev/null && mv -f "$CRON_BACKUP.partial" "$CRON_BACKUP"; then
    crontab -l 2>/dev/null | grep -v "$MONITOR_CRON_MATCH" | crontab -
    trap restore_cron EXIT
    log "Monitor cron paused"
else
    rm -f "$CRON_BACKUP.partial"
    log "WARNING: no durable cron backup at $CRON_BACKUP - leaving the monitor cron running"
fi

# ============================================================================
# Send Initial "Restarting" Message
# ============================================================================
log "Starting scheduled restart for $SERVER_NAME"
log "Active ports: ${PORTS[*]}"
if [ ${#SKIPPED[@]} -gt 0 ]; then
    log "Skipped ports (.ktp-disabled): ${SKIPPED[*]}"
fi
FOOTER_TIMESTAMP=$(TZ='America/New_York' date '+%m/%d/%Y %I:%M %p EST')

INIT_TITLE="$KTP_EMOJI Server Restart In Progress"
INIT_DESC="Stopping all game servers..."

log "Sending initial Discord notification..."
MSG_ID_KTP=$(send_discord_embed "$CHANNEL_KTP" "$INIT_TITLE" "$INIT_DESC" "$COLOR_ORANGE" "$SERVER_NAME - $FOOTER_TIMESTAMP")
MSG_ID_EXT=$(send_discord_embed "$CHANNEL_EXTERNAL" "$INIT_TITLE" "$INIT_DESC" "$COLOR_ORANGE" "$SERVER_NAME - $FOOTER_TIMESTAMP")
log "Message IDs: KTP=$MSG_ID_KTP, External=$MSG_ID_EXT"

# ============================================================================
# Stop All Servers (LinuxGSM graceful stop)
# ============================================================================
log "Stopping all servers via LinuxGSM..."

for port in "${PORTS[@]}"; do
    n=$((port - 27014))
    if [ $n -eq 1 ]; then
        SERVER_EXEC="dodserver"
    else
        SERVER_EXEC="dodserver$n"
    fi

    cd ~/dod-$port
    ./$SERVER_EXEC stop >/dev/null 2>&1 &
done

if [ "$WARMUP_PRESENT" -eq 1 ]; then
    log "Stopping warmup instance ($WARMUP_DIR)..."
    ( cd "$WARMUP_DIR" && ./"$WARMUP_EXEC" stop >/dev/null 2>&1 ) &
fi

# Wait for stops to complete — poll until BOTH hlds_linux processes and
# dodserver tmux sessions are gone. The previous implementation slept for a
# fixed 10 seconds, which wasn't enough for the worst case: LinuxGSM's STOP
# fires graceful `quit` to hlds_linux, waits up to 3s for it to exit, then
# tears down the tmux session. If the graceful quit drags, the total stop
# duration exceeds 10s. The sequential starts that follow would race against
# still-pending tmux teardown and abort with "NOT SET is already running",
# leaving the affected instance down until manual intervention — observed on
# Denver 27015 at 2026-04-20 03:00.
log "Waiting for servers to stop (polling)..."
MAX_WAIT=30
ELAPSED=0
while [ $ELAPSED -lt $MAX_WAIT ]; do
    HLDS_COUNT=$(pgrep -c hlds_linux 2>/dev/null || echo "0")
    HLDS_COUNT=${HLDS_COUNT//[^0-9]/}
    TMUX_COUNT=$(pgrep -cf 'tmux -L dodserver' 2>/dev/null || echo "0")
    TMUX_COUNT=${TMUX_COUNT//[^0-9]/}
    if [ "${HLDS_COUNT:-0}" -eq 0 ] && [ "${TMUX_COUNT:-0}" -eq 0 ]; then
        log "All hlds_linux processes and dodserver tmux sessions stopped (after ${ELAPSED}s)"
        break
    fi
    sleep 1
    ELAPSED=$((ELAPSED + 1))
done

# Force-kill anything stuck after max wait
if [ $ELAPSED -ge $MAX_WAIT ]; then
    log "WARNING: Stops did not complete in ${MAX_WAIT}s (hlds=$HLDS_COUNT tmux=$TMUX_COUNT), force-killing..."
    pkill -9 hlds_run 2>/dev/null
    pkill -9 hlds_linux 2>/dev/null
    pkill -9 -f 'tmux -L dodserver' 2>/dev/null
    sleep 3
fi

log "All servers stopped"

# ============================================================================
# Swap in any pending `.new` files (safe: all servers are stopped here)
# ============================================================================
# Binary deploys stage `.new` files next to their targets; the nightly restart
# is the only safe moment to move them into place (.so files are memory-mapped
# while hlds_linux runs, so overwriting mid-run crashes the process).
#
# Covered locations (match what the deploy pipelines emit):
#   ~/dod-*/serverfiles/*.new                            # engine_i486.so, hlds_linux, libsteam_api.so
#   ~/dod-*/serverfiles/dod/addons/ktpamx/dlls/*.new     # ktpamx_i386.so
#   ~/dod-*/serverfiles/dod/addons/ktpamx/modules/*.new  # dodx, reapi, amxxcurl
#   ~/dod-*/serverfiles/dod/addons/ktpamx/plugins/*.new  # *.amxx (KTPMatchHandler, KTPHLTVRecorder, etc)
log "Checking for staged .new files..."
SWAP_COUNT=0
SWAP_FAILED=0
SWAP_FAILED_FILES=()
SWAP_BASES=()
for port in "${PORTS[@]}"; do
    SWAP_BASES+=(~/dod-$port/serverfiles)
done
# Warmup runs the same stack, so a wave staged there must activate the same way.
[ "$WARMUP_PRESENT" -eq 1 ] && SWAP_BASES+=("$WARMUP_DIR/serverfiles")
for BASE in "${SWAP_BASES[@]}"; do
    # Log label only: keeps the existing "[27015]" form, warmup reads "[warmup]".
    port=$(basename "$(dirname "$BASE")"); port=${port#dod-}
    for new_file in "$BASE"/*.new \
                    "$BASE"/dod/addons/ktpamx/dlls/*.new \
                    "$BASE"/dod/addons/ktpamx/modules/*.new \
                    "$BASE"/dod/addons/ktpamx/plugins/*.new; do
        [ -f "$new_file" ] || continue
        target="${new_file%.new}"
        if mv -f "$new_file" "$target"; then
            # KTP: preserve executable bit. SFTP-uploaded .new files default to
            # 644; `mv` replaces target's permissions with source's, so after the
            # swap the previously-755 binaries lose +x. Root cause of the
            # 2026-04-24 outage (fleet-wide loss of +x on hlds_linux caused all
            # 24 instances to fail startup). Idempotent chmod +x applied to every
            # swapped file — hlds_linux, engine_i486.so, ktpamx_i386.so, and
            # dodx_ktp_i386.so all benefit (the .so files don't strictly need +x
            # but conventionally are 755, matching LinuxGSM's default).
            chmod +x "$target"
            log "  [$port] swapped: $(basename "$target")"
            SWAP_COUNT=$((SWAP_COUNT + 1))
        else
            log "  [$port] FAILED to swap: $new_file"
            SWAP_FAILED=$((SWAP_FAILED + 1))
            SWAP_FAILED_FILES+=("[$port] $new_file")
        fi
    done
done
if [ "$SWAP_COUNT" -eq 0 ] && [ "$SWAP_FAILED" -eq 0 ]; then
    log "No .new files pending — nothing to swap"
else
    log "Swap complete: $SWAP_COUNT succeeded, $SWAP_FAILED failed"
fi

# A non-zero SWAP_FAILED means this host activated a wave PARTIALLY: some
# targets are now running new binaries, others are still on old ones. For a
# single-artifact deploy that's a nuisance; for a coupled multi-artifact wave
# it can mean two halves of the stack that were never meant to run together
# are now running together. Deliberately NOT escalated to aborting the server
# start below — refusing to start leaves players on a server that is DOWN,
# which is worse than one running a mismatched-but-working stack, and the
# .new file that failed to move is itself left behind as a durable record
# (see scripts/ktp-verify-post-swap.sh — check the morning after, don't rely
# on catching this log line live).
if [ "$SWAP_FAILED" -gt 0 ]; then
    log "SWAP FAILURE: $SWAP_FAILED file(s) did NOT activate — wave PARTIALLY applied on this host:"
    for f in "${SWAP_FAILED_FILES[@]}"; do
        log "  UNSWAPPED: $f"
    done
fi

# ============================================================================
# Start All Servers
# ============================================================================
log "Starting servers..."

for port in "${PORTS[@]}"; do
    n=$((port - 27014))
    if [ $n -eq 1 ]; then
        SERVER_EXEC="dodserver"
    else
        SERVER_EXEC="dodserver$n"
    fi

    cd ~/dod-$port
    if ./$SERVER_EXEC start >/dev/null 2>&1; then
        log "Started $SERVER_EXEC (port $port)"
        # Belt-and-suspenders: ensure -monitoring.lock exists so monitor cron
        # will pick up this instance after a crash or OS reboot. LinuxGSM's
        # command_start.sh creates this itself at its line ~170, but we've
        # observed it go missing (DAL:27015 2026-04-23). Without the file,
        # monitor treats the server as "intentionally stopped" and refuses to
        # restart it. Idempotent — only creates if absent.
        LOCK=~/dod-$port/lgsm/lock/$SERVER_EXEC-monitoring.lock
        if [ ! -f "$LOCK" ]; then
            date +%s > "$LOCK"
            log "  [$port] created missing $SERVER_EXEC-monitoring.lock"
        fi
    else
        log "FAILED to start $SERVER_EXEC (port $port)"
    fi
    sleep 3
done

if [ "$WARMUP_PRESENT" -eq 1 ]; then
    if ( cd "$WARMUP_DIR" && ./"$WARMUP_EXEC" start >/dev/null 2>&1 ); then
        log "Started warmup ($WARMUP_DIR)"
        # Same lockfile gap as the instances above: without it the monitor cron
        # reads warmup as intentionally stopped and never revives it.
        WARMUP_LOCK="$WARMUP_DIR/lgsm/lock/$WARMUP_EXEC-monitoring.lock"
        if [ ! -f "$WARMUP_LOCK" ]; then
            date +%s > "$WARMUP_LOCK" 2>/dev/null \
                && log "  [warmup] created missing $WARMUP_EXEC-monitoring.lock"
        fi
    else
        log "FAILED to start warmup ($WARMUP_DIR)"
    fi
    sleep 3
fi

# Verify servers are running
sleep 5
RUNNING=$(pgrep -c hlds_linux 2>/dev/null || echo "0")
RUNNING=${RUNNING//[^0-9]/}  # Strip non-numeric chars
RUNNING=${RUNNING:-0}
if [ "$WARMUP_PRESENT" -eq 1 ]; then
    log "Verification: $RUNNING/$EXPECTED_RUNNING running (${NUM_SERVERS} match + 1 warmup)"
else
    log "Verification: $RUNNING/$EXPECTED_RUNNING servers running"
fi

# ============================================================================
# Apply CPU Pinning + Real-Time Scheduling
# ============================================================================
log "Applying CPU pinning + SCHED_FIFO 50 to all game servers..."

# Fixed PORT-keyed maps — MUST match /usr/local/bin/ktp-apply-chrt.sh (the
# 5-min ktp-chrt timer, deploy-chrt-service.sh). The old code built the map
# by INDEX over the dynamic PORTS array, which diverged from the timer's
# fixed map whenever a mid-list instance was disabled: this script pinned one
# core at restart, then the timer re-pinned a different core every 5 minutes,
# migrating a live game process between physical cores each cycle. Ports
# outside the map (e.g. a 6-instance LAN layout) skip the taskset here — the
# per-host ktp-chrt timer, whose generated map covers them, is authoritative;
# SCHED_FIFO still applies to every instance.
NUM_CPUS=$(nproc --all)
if [ "$NUM_CPUS" -le 4 ]; then
    # Chicago 4-vCPU layout (deploy-chrt-service.sh --chicago)
    declare -A PORT_CPU_MAP=([27015]=1 [27016]=2 [27017]=3 [27018]=0 [27019]=0)
else
    # Baremetal 4c/8t layout: sibling pairs (0,4)(1,5)(2,6)(3,7); 0,1=housekeeping.
    # NB: a non-fleet >4-CPU box (e.g. the LAN W-2245) gets this map too, which
    # may differ from its provision-generated ktp-apply-chrt.sh — one migration
    # per restart, corrected by the 5-min timer. Fleet behavior is exact.
    declare -A PORT_CPU_MAP=([27015]=2 [27016]=5 [27017]=4 [27018]=3 [27019]=7)
fi

for pid in $(pgrep -f hlds_linux); do
    port=$(tr '\0' ' ' < /proc/$pid/cmdline 2>/dev/null | grep -oP '(?<=-port )\d+')
    [ -z "$port" ] && port=$(ps -p "$pid" -o args= 2>/dev/null | grep -oP '(?<=-port )\d+')
    [ -z "$port" ] && continue

    target_cpu=${PORT_CPU_MAP[$port]:-}
    if [ -n "$target_cpu" ]; then
        if sudo taskset -cp "$target_cpu" "$pid" 2>/dev/null; then
            log "Pinned port $port PID $pid to CPU $target_cpu"
        fi
    else
        log "Port $port not in the pin map — leaving placement to the ktp-chrt timer"
    fi
    if sudo chrt -f -p 50 "$pid" 2>/dev/null; then
        log "Applied SCHED_FIFO 50 to port $port PID $pid"
    fi
done

# ============================================================================
# KTP extension-loader assert (soft, version-aware) — ReHLDS .928+
# ============================================================================
# .928 exposes `ktp_extension_loaded` — the count of extensions the loader
# initialized this process. 0 after a start means KTPAMXX never loaded and the
# whole plugin stack is silently absent. Query each instance's console via
# LinuxGSM `send` and read the reply from the console log. Version-aware by
# construction: pre-.928 engines print nothing for the unknown name (server
# console ignores unknown commands silently — verified on .927), so absence of
# a reply is N/A, never a failure. Soft assert — logs + flags the Discord
# status; never aborts the restart.
log "Checking KTP extension loader (ktp_extension_loaded, .928+)..."
EXT_FAILED_PORTS=""
for port in "${PORTS[@]}"; do
    n=$((port - 27014))
    if [ $n -eq 1 ]; then SERVER_EXEC="dodserver"; else SERVER_EXEC="dodserver$n"; fi
    ( cd ~/dod-$port && ./$SERVER_EXEC send "ktp_extension_loaded" >/dev/null 2>&1 )
done
sleep 3
for port in "${PORTS[@]}"; do
    CONSOLE_LOG=$(ls -t ~/dod-$port/log/console/*-console*.log 2>/dev/null | head -1)
    if [ -z "$CONSOLE_LOG" ]; then
        log "  [$port] no console log found — extension check skipped"
        continue
    fi
    # Reply line is `"ktp_extension_loaded" is "N"` at column 0; the echoed
    # typed command is unquoted, so the anchored quote can't false-match it.
    VAL=$(tail -80 "$CONSOLE_LOG" | grep -oP '^"ktp_extension_loaded" is "\K[0-9]+' | tail -1)
    if [ -z "$VAL" ]; then
        log "  [$port] ktp_extension_loaded not reported (pre-.928 engine or no console echo) — skipped"
    elif [ "$VAL" -ge 1 ]; then
        log "  [$port] ktp_extension_loaded=$VAL OK"
    else
        log "  [$port] WARNING: ktp_extension_loaded=$VAL — extension loader FAILED, KTPAMXX not loaded!"
        EXT_FAILED_PORTS="$EXT_FAILED_PORTS $port"
    fi
done

# ============================================================================
# Stale curl socket-map sweep (KTPAMXXCurl) — soft, but escalates on its own
# ============================================================================
# KTPAMXXCurl hands its sockets to asio and lets libcurl keep connections alive
# across requests; `stale socket_map_ entry` is the module reporting an fd in its
# map that libcurl had already disowned. It has never been seen on the fleet.
# That is exactly why it was a recurring hand-run chore and could never close —
# only a HIT closes it, so a human re-grepped five hosts forever. Here it is a
# monitor instead, and a monitor has to survive being wrong.
#
# A quiet sweep is still not proof of health: it keys on `socket_map_`, which the
# close callback has just emptied, so it cannot catch the recycled-fd case.
#
# THREE things this sweep has to get right. All three have already produced an
# answer that looked clean and meant nothing:
#
#   1. TWO LOG TREES PER INSTANCE. `serverfiles/dod/logs` (HLDS) and
#      `serverfiles/dod/addons/ktpamx/logs` (AMXX). The module logs through the
#      AMXX logger, so a sweep of the HLDS tree alone returns a zero about the
#      wrong tree. Both are scanned, and each is controlled separately.
#   2. `grep -I`, and the LOG trees rather than the dod tree. The string is a
#      compiled-in constant inside `addons/ktpamx/modules/amxxcurl_ktp_i386.so`
#      — grepping the tree returns one hit per instance, all of them the
#      module's own error message rather than log output.
#   3. A POSITIVE CONTROL, per tree. "no hits" and "did not read any logs" are
#      the same output otherwise. Every line either logger writes is stamped
#      `L MM/DD/YYYY - `, so a tree whose control matches zero files was not
#      read, and is reported BLIND — never as clean.
#
# Bounded to the last KTP_SOCKMAP_SCAN_DAYS days (2) rather than all history:
# ~1,280 HLDS files per instance accumulate since 2026, and re-reading them
# nightly buys nothing. The job runs nightly, so a 48h window overlaps itself
# and a single skipped night still leaves no gap. A duplicate report costs an
# operator one glance; a gap costs the finding.
SOCKMAP_PATTERN='stale socket_map_ entry'
SOCKMAP_CONTROL='^L [0-9][0-9]/[0-9][0-9]/[0-9][0-9][0-9][0-9] - '
SOCKMAP_DAYS="${KTP_SOCKMAP_SCAN_DAYS:-2}"
SOCKMAP_HITS=0
SOCKMAP_HIT_FILES=()
SOCKMAP_BLIND=()

SOCKMAP_TREES=()
for port in "${PORTS[@]}"; do
    SOCKMAP_TREES+=("$port|hlds|$HOME/dod-$port/serverfiles/dod/logs")
    SOCKMAP_TREES+=("$port|amxx|$HOME/dod-$port/serverfiles/dod/addons/ktpamx/logs")
done
if [ "$WARMUP_PRESENT" -eq 1 ]; then
    SOCKMAP_TREES+=("warmup|hlds|$WARMUP_DIR/serverfiles/dod/logs")
    SOCKMAP_TREES+=("warmup|amxx|$WARMUP_DIR/serverfiles/dod/addons/ktpamx/logs")
fi

log "Sweeping both log trees for stale curl socket-map entries (last ${SOCKMAP_DAYS}d)..."
for spec in "${SOCKMAP_TREES[@]}"; do
    sm_port="${spec%%|*}"; sm_rest="${spec#*|}"
    sm_kind="${sm_rest%%|*}"; sm_tree="${sm_rest#*|}"

    if [ ! -d "$sm_tree" ]; then
        log "  [$sm_port] $sm_kind: BLIND — no such tree: $sm_tree"
        SOCKMAP_BLIND+=("[$sm_port] $sm_kind (missing)")
        continue
    fi

    # The file list is materialised once so the hit count and the control count
    # are provably over the SAME set. Two independent finds could disagree
    # across a log rotation, which is the one way a control stops controlling.
    SM_LIST=$(mktemp 2>/dev/null)
    if [ -z "$SM_LIST" ]; then
        log "  [$sm_port] $sm_kind: BLIND — mktemp failed"
        SOCKMAP_BLIND+=("[$sm_port] $sm_kind (mktemp)")
        continue
    fi
    find "$sm_tree" -type f -mtime -"$SOCKMAP_DAYS" -print0 2>/dev/null > "$SM_LIST"

    SM_CTRL=$(xargs -0 -r grep -lIE -- "$SOCKMAP_CONTROL" < "$SM_LIST" 2>/dev/null | wc -l)
    SM_CTRL=${SM_CTRL//[^0-9]/}
    if [ "${SM_CTRL:-0}" -eq 0 ]; then
        log "  [$sm_port] $sm_kind: BLIND — control matched 0 files in $sm_tree"
        SOCKMAP_BLIND+=("[$sm_port] $sm_kind (control 0)")
        rm -f "$SM_LIST"
        continue
    fi

    SM_TREE_HITS=0
    while IFS= read -r sm_file; do
        [ -n "$sm_file" ] || continue
        SM_TREE_HITS=$((SM_TREE_HITS + 1))
        SOCKMAP_HITS=$((SOCKMAP_HITS + 1))
        SOCKMAP_HIT_FILES+=("[$sm_port] $sm_file")
    done < <(xargs -0 -r grep -lI -- "$SOCKMAP_PATTERN" < "$SM_LIST" 2>/dev/null)
    rm -f "$SM_LIST"

    if [ "$SM_TREE_HITS" -gt 0 ]; then
        log "  [$sm_port] $sm_kind: $SM_TREE_HITS file(s) HIT, across $SM_CTRL read"
    else
        log "  [$sm_port] $sm_kind: clean across $SM_CTRL file(s) read"
    fi
done

if [ "$SOCKMAP_HITS" -gt 0 ]; then
    log "STALE SOCKET MAP: $SOCKMAP_HITS log file(s) carry '$SOCKMAP_PATTERN':"
    for sm_file in "${SOCKMAP_HIT_FILES[@]}"; do
        log "  SOCKMAP: $sm_file"
    done
fi
if [ ${#SOCKMAP_BLIND[@]} -gt 0 ]; then
    log "SOCKMAP SWEEP BLIND on ${#SOCKMAP_BLIND[@]} tree(s) — a zero from these means nothing:"
    for sm_b in "${SOCKMAP_BLIND[@]}"; do
        log "  BLIND: $sm_b"
    done
fi

# Identify any failed ports
FAILED_PORTS=""
if [ "$RUNNING" -ne "$EXPECTED_RUNNING" ]; then
    for port in "${PORTS[@]}"; do
        if ! pgrep -f "\-port $port " >/dev/null 2>&1; then
            FAILED_PORTS="$FAILED_PORTS $port"
        fi
    done
    # Warmup has no entry in PORTS, so without this a warmup-only failure
    # reports as "partial" with an empty failed list — the least actionable
    # possible alert.
    if [ "$WARMUP_PRESENT" -eq 1 ] && ! pgrep -f "\-port ${KTP_WARMUP_PORT:-27050} " >/dev/null 2>&1; then
        FAILED_PORTS="$FAILED_PORTS warmup"
    fi
fi

# ============================================================================
# Update Discord Message with Final Status
# ============================================================================
FOOTER_TIMESTAMP=$(TZ='America/New_York' date '+%m/%d/%Y %I:%M %p EST')

if [ "$RUNNING" -eq "$EXPECTED_RUNNING" ]; then
    FINAL_TITLE="$KTP_EMOJI Server Restart Complete"
    FINAL_DESC="All $EXPECTED_RUNNING game servers restarted successfully."
    FINAL_COLOR=$COLOR_GREEN
elif [ "$RUNNING" -gt 0 ]; then
    FINAL_TITLE="$KTP_EMOJI Server Restart - Partial"
    FINAL_DESC="$RUNNING/$EXPECTED_RUNNING servers restarted.\\n**Failed ports:**$FAILED_PORTS"
    FINAL_COLOR=$COLOR_ORANGE
else
    FINAL_TITLE="$KTP_EMOJI Server Restart Failed"
    FINAL_DESC="All servers failed to restart!"
    FINAL_COLOR=$COLOR_RED
fi

# Extension-loader failure rides into the embed (never downgrades a red)
if [ -n "$EXT_FAILED_PORTS" ]; then
    FINAL_DESC="$FINAL_DESC\\n**KTP extension loader FAILED on:**$EXT_FAILED_PORTS"
    if [ "$FINAL_COLOR" -eq "$COLOR_GREEN" ]; then
        FINAL_COLOR=$COLOR_ORANGE
    fi
fi

# Swap failure rides into the embed too, and — unlike the checks above — it
# must escalate even when every server came up green. "All servers restarted
# successfully" while a wave sits half-applied is the exact silent outcome
# this guard exists to close.
if [ "$SWAP_FAILED" -gt 0 ]; then
    FINAL_DESC="$FINAL_DESC\\n**SWAP FAILED on $SWAP_FAILED file(s) — wave PARTIALLY applied, see restart log:**${SWAP_FAILED_FILES[*]}"
    if [ "$FINAL_COLOR" -eq "$COLOR_GREEN" ]; then
        FINAL_COLOR=$COLOR_ORANGE
    fi
fi

# The socket-map sweep rides in on the same terms as the swap failure above, and
# for the same reason: it must escalate even when every server came up green,
# because the whole finding is orthogonal to whether the restart worked.
#
# A BLIND tree escalates too. "I found nothing" and "I did not look" are the same
# embed otherwise, and this check exists precisely because a zero nobody could
# distinguish from a non-measurement was re-run by hand five times.
#
# Deliberately NOT reflected in the exit code, unlike SWAP_FAILED. The exit code
# is the restart's own verdict, and a stale socket-map entry says nothing about
# whether the restart succeeded; conflating them would make cron report a healthy
# fleet as a failed job every night until someone fixed a module bug.
if [ "$SOCKMAP_HITS" -gt 0 ]; then
    FINAL_DESC="$FINAL_DESC\\n**STALE SOCKET MAP in $SOCKMAP_HITS log file(s) — KTPAMXXCurl connection reuse, see restart log:**${SOCKMAP_HIT_FILES[*]}"
    if [ "$FINAL_COLOR" -eq "$COLOR_GREEN" ]; then
        FINAL_COLOR=$COLOR_ORANGE
    fi
fi
if [ ${#SOCKMAP_BLIND[@]} -gt 0 ]; then
    FINAL_DESC="$FINAL_DESC\\n**Socket-map sweep BLIND on ${#SOCKMAP_BLIND[@]} log tree(s) — its zero is not a measurement:**${SOCKMAP_BLIND[*]}"
    if [ "$FINAL_COLOR" -eq "$COLOR_GREEN" ]; then
        FINAL_COLOR=$COLOR_ORANGE
    fi
fi

log "Updating Discord messages with final status..."
if [ -n "$MSG_ID_KTP" ]; then
    edit_discord_embed "$CHANNEL_KTP" "$MSG_ID_KTP" "$FINAL_TITLE" "$FINAL_DESC" "$FINAL_COLOR" "$SERVER_NAME - $FOOTER_TIMESTAMP"
fi
if [ -n "$MSG_ID_EXT" ]; then
    edit_discord_embed "$CHANNEL_EXTERNAL" "$MSG_ID_EXT" "$FINAL_TITLE" "$FINAL_DESC" "$FINAL_COLOR" "$SERVER_NAME - $FOOTER_TIMESTAMP"
fi

log "Scheduled restart complete. $RUNNING/$EXPECTED_RUNNING servers running."

# Cron will be restored by trap on EXIT

# Non-zero exit on a swap failure — even when every server ends up running —
# so cron's own log/mail path and any external wrapper see this run as
# failed, not just the Discord embed. The trap above still fires on this exit
# and restores the monitor cron either way.
if [ "$SWAP_FAILED" -gt 0 ]; then
    exit 1
fi

#!/usr/bin/env python3
"""Install a file from a git commit and record it in the deploy manifest.

    ktp-install --repo DIR --commit SHA --src PATH --dest PATH --expect-md5 MD5|-
    ktp-install --file F --source-repo NAME --commit SHA --src PATH --blob-md5 MD5 --dest PATH --expect-md5 MD5|-
    ktp-install --file F --template --source-repo NAME --commit SHA --src PATH.example --dest PATH --expect-md5 MD5|-
    ktp-install --record-only --repo DIR --commit SHA --src PATH --dest PATH
    ktp-install --report [--repo DIR] [--against-ref REF]
    ktp-install --plan --repo DIR --against-ref REF [--stage-dir DIR]

The installed bytes are the git blob, so a file's md5 alone identifies the commit
it came from; the manifest records which one. No version string is written into
any script: labels drift, bytes do not.

Where there is no checkout (the game hosts), push the bytes and pass --file with
--blob-md5, taken from `git show SHA:PATH | md5sum` where the repo is. A filled
template cannot equal any blob: pass --template, and the row records the
template's commit and path with the filled file's md5.

An install is a copy, so it refuses a no-op: a file that is already correct but
was never recorded could not be reconciled at all, and --report had no way to
stop indicting it. --record-only closes that. It writes the manifest row for a
file already in place and copies nothing, but only after hashing the bytes on
disk and finding them equal to the blob at that commit -- so it can state a
thing it checked and nothing else. It needs --repo, because without the blob
here the row would rest on the caller's word, which is the drift it exists to
clear. A row it writes carries previous_md5 == md5; the install path refuses a
no-op, so it can never write one, and that is how the two are told apart.

Manifest, one format in two places: /usr/local/share/ktp-infra/DEPLOYED.tsv when
run as root, ~/.ktp/DEPLOYED.tsv otherwise, so dodserver never needs sudo.
KTP_MANIFEST overrides both. Append-only, one header line then one row per
install; a path's current state is its LAST row.

--report reads every manifest that applies on the host. It exits 0 when every
recorded file still has the md5 of its last row, 1 on drift or a missing file,
and 2 when there is no manifest or one cannot be parsed.

⚠️ --report ALONE ANSWERS "UNTOUCHED SINCE INSTALL", NOT "CURRENT". Those read
identically in the output and are not the same question. A file nobody has
touched since the day it was installed reports OK forever while the repo merges
past it, because the bytes still match the row and the row is what went stale.
That is how the tier-2 stack-drift checker ran superseded logic for weeks with
this report calling it healthy -- and the same gap covers most of the installed
estate, not one script. Nothing in /usr/local/bin is deployed by anything but a
person remembering to copy it, so "merged" and "running" drift by default.

--against-ref REF closes that. It resolves each row's source_path at REF and
compares the INSTALLED bytes to what REF holds, so an untouched file reports
STALE once the repo moves past it. Needs --repo (the ref is resolved there).
Rows naming a different source_repo print OTHER-REPO and are not compared --
one manifest may carry several repos. A ref that does not resolve exits 2
rather than passing: a freshness check that could not run must not read as
fresh, and neither may a source_path the ref no longer holds (SOURCE-GONE).
A recorded commit the checkout does not carry is noted, not indicted: shallow
clones are the normal CI checkout, so that must not read as a mismatch.

🔴 AND THE BASELINE ITSELF IS CHECKED, because this is where the check was blind.
A ref under refs/remotes/ is this checkout's CACHE of someone else's branch and
nothing here keeps it current -- measured on the data server, the deploy
checkout's `origin/main` was 214 commits behind GitHub's, so every row compared
against it printed CURRENT and the report exited 0. A freshness check that must
not read as fresh when it could not run must equally not read as fresh when it
ran against last week. So the report asks the remote whether that ref is the
branch's tip (`ls-remote`, no fetch, nothing written) and exits 2 saying both
shas when it is not. A ref that tracks no remote -- a sha, a tag, HEAD, a local
branch -- claims nothing, so it is accepted and LABELLED as the pin it is. The
first line of every --against-ref run is that baseline and how it was settled;
it is not a row, so a parser keying on the state token must skip it.

--plan is the step this estate has never had. With a settled baseline it prints
the ktp-install commands that would bring every STALE row up to REF and writes
nothing at all. Each is pinned twice to bytes measured in that run -- --expect-md5
to what is on the box, --blob-md5 to what REF holds -- so a plan that has gone
out of date refuses rather than clobbers, and one staged from the wrong tree
refuses too. It can only be reached through an authenticated baseline, so it
cannot emit a plan that installs stale bytes as though they were current: the
gate is what makes the deploy step safe to generate, which is why it came first.
It covers the RECORDED estate only, and it is not a dependency order.
"""

import argparse
import fcntl
import getpass
import hashlib
import os
import re
import shlex
import socket
import subprocess
import sys
import time

SYSTEM_MANIFEST = "/usr/local/share/ktp-infra/DEPLOYED.tsv"
USER_MANIFEST = os.path.expanduser("~/.ktp/DEPLOYED.tsv")
HEADER = ["installed_path", "md5", "source_repo", "source_commit", "source_path",
          "deployed_at_iso", "previous_md5", "deployed_by"]
HEX = re.compile(r"[0-9a-f]+\Z")

# The never-pulled deploy checkout. Reading it is legitimate -- `--report --against-ref`
# wants a tree to compare against -- but it is never a source of bytes: nothing on this box
# pulls it, so an install from here lands stale bytes and looks exactly like a deploy. It had
# already produced one stale live file before this guard existed.
NEVER_INSTALL_FROM = "/opt/ktp-infra"


def refuse_stale_source(ap, repo):
    """Refuse an install whose bytes would come from the never-pulled checkout.

    No override, on purpose: --file needs no checkout, so an escape hatch would only ever
    be reached by someone who had not read why this exists.
    """
    if not repo:
        return
    target = os.path.realpath(NEVER_INSTALL_FROM)
    resolved = os.path.realpath(repo)
    if resolved != target and not resolved.startswith(target + os.sep):
        return
    ap.error(
        "refusing to install from %s: it is the never-pulled deploy checkout, so its bytes are "
        "stale by construction. Install with --file plus --source-repo, --commit and --blob-md5: "
        "that takes the bytes from a file you staged and needs no checkout on this box at all. "
        "A checkout may be the source only when it is AT origin/main, which no tree here is kept "
        "at. (--report --against-ref may still read this one; only copying bytes out is refused.)"
        % NEVER_INSTALL_FROM)


class ManifestError(Exception):
    pass


class Untrusted(Exception):
    """A baseline we cannot stand behind. It is never allowed to become a freshness verdict."""


_LS_REMOTE_TIMEOUT = 20


def remote_tracking(repo, ref):
    """(remote, branch) when REF is this checkout's CACHE of a remote branch, else None."""
    p = subprocess.run(["git", "-C", repo, "rev-parse", "--symbolic-full-name", ref],
                       capture_output=True, text=True)
    full = p.stdout.strip() if p.returncode == 0 else ""
    if not full.startswith("refs/remotes/"):
        return None
    rest = full[len("refs/remotes/"):]
    remotes = subprocess.run(["git", "-C", repo, "remote"],
                             capture_output=True, text=True).stdout.split()
    # A branch name may contain a slash, so the remote is the longest configured prefix.
    for name in sorted(remotes, key=len, reverse=True):
        if rest.startswith(name + "/"):
            return name, rest[len(name) + 1:]
    return None


def settle_baseline(repo, ref, ref_commit):
    """Return how this baseline was established, or raise Untrusted saying why it cannot be.

    A ref under refs/remotes/ is a local CACHE of someone else's branch and nothing
    here keeps it current. Measured on the data server: `origin/main` in the deploy
    checkout was 214 commits behind GitHub's, so every row compared against it read
    CURRENT -- the check failing in the reassuring direction, which is worse than no
    check. So the claim is checked against the remote instead of trusted. A ref that
    tracks nothing claims nothing, and is reported as the pin it is.
    """
    tracking = remote_tracking(repo, ref)
    if tracking is None:
        return "pinned; tracks no remote, so CURRENT below means current with this commit only"
    remote, branch = tracking
    hint = ("Fetch it -- git -C %s fetch --no-tags --refmap= %s "
            "+refs/heads/%s:refs/remotes/%s/%s -- and run again, or pass the 40-hex sha you mean "
            "to compare against, which claims nothing about tracking."
            % (repo, remote, branch, remote, branch))
    try:
        p = subprocess.run(["git", "-C", repo, "ls-remote", "--heads", remote, "refs/heads/" + branch],
                           capture_output=True, text=True, timeout=_LS_REMOTE_TIMEOUT)
    except subprocess.TimeoutExpired:
        raise Untrusted("cannot reach %s to confirm %s is its tip: ls-remote timed out after %ds. %s"
                        % (remote, ref, _LS_REMOTE_TIMEOUT, hint))
    if p.returncode != 0:
        why = " ".join((p.stderr or "").split())[:200] or "git ls-remote exited %d" % p.returncode
        raise Untrusted("cannot reach %s to confirm %s is its tip: %s. %s" % (remote, ref, why, hint))
    tip = p.stdout.split("\t")[0].strip() if p.stdout.strip() else ""
    if not tip:
        raise Untrusted("%s has no refs/heads/%s, so %s caches a branch that no longer exists "
                        "and cannot be anyone's idea of current. %s" % (remote, branch, ref, hint))
    if tip != ref_commit:
        # No distance: the tip is not in this object store, so any count would be a
        # guess, and a number in a message rots anyway. Both shas are the evidence.
        raise Untrusted("%s in %s is %s but %s's refs/heads/%s is %s: the baseline is not that "
                        "branch, so every CURRENT below would mean current-with-a-stale-%s. %s"
                        % (ref, repo, ref_commit, remote, branch, tip, branch, hint))
    return "verified against %s refs/heads/%s @ %s" % (remote, branch, tip)


def manifest_for_writes():
    if os.environ.get("KTP_MANIFEST"):
        return os.environ["KTP_MANIFEST"]
    return SYSTEM_MANIFEST if os.geteuid() == 0 else USER_MANIFEST


def manifests_for_report():
    if os.environ.get("KTP_MANIFEST"):
        return [os.environ["KTP_MANIFEST"]]
    return [SYSTEM_MANIFEST, USER_MANIFEST]


def backup_dir():
    if os.environ.get("KTP_INSTALL_BACKUPS"):
        return os.environ["KTP_INSTALL_BACKUPS"]
    return "/var/backups/ktp-install" if os.geteuid() == 0 else os.path.expanduser("~/.ktp/backups")


def is_template(source_path):
    return source_path.endswith(".example")


def md5_bytes(b):
    return hashlib.md5(b).hexdigest()


def md5_file(path):
    try:
        with open(path, "rb") as f:
            return md5_bytes(f.read())
    except FileNotFoundError:
        return "-"


def git(repo, *args):
    p = subprocess.run(["git", "-C", repo, *args], capture_output=True)
    if p.returncode != 0:
        raise SystemExit("git %s failed: %s" % (" ".join(args), p.stderr.decode(errors="replace").strip()))
    return p.stdout


def repo_name(repo):
    url = subprocess.run(["git", "-C", repo, "remote", "get-url", "origin"],
                         capture_output=True, text=True).stdout.strip()
    name = url.rstrip("/").split("/")[-1] if url else os.path.basename(os.path.abspath(repo))
    return name[:-4] if name.endswith(".git") else name


def read_manifest(path):
    """Rows as dicts. Anything malformed raises: a manifest we cannot parse proves nothing."""
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().split("\n")
    except OSError as e:
        raise ManifestError("cannot read %s: %s" % (path, e))
    if lines and lines[-1] == "":
        lines.pop()
    if not lines or lines[0].split("\t") != HEADER:
        raise ManifestError("%s: missing or unexpected header" % path)
    rows = []
    for n, line in enumerate(lines[1:], start=2):
        cols = line.split("\t")
        if len(cols) != len(HEADER):
            raise ManifestError("%s:%d: expected %d columns, got %d" % (path, n, len(HEADER), len(cols)))
        row = dict(zip(HEADER, cols))
        if not (len(row["md5"]) == 32 and HEX.match(row["md5"])
                and len(row["source_commit"]) == 40 and HEX.match(row["source_commit"])):
            raise ManifestError("%s:%d: md5 or commit is not full-length hex" % (path, n))
        rows.append(row)
    return rows


def append_row(row, path):
    for v in row.values():
        if "\t" in v or "\n" in v:
            raise SystemExit("refusing to write a field containing a tab or newline: %r" % v)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "a+", encoding="utf-8") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        f.seek(0)
        existing = f.read()
        if not existing:
            f.write("\t".join(HEADER) + "\n")
        elif not existing.startswith("\t".join(HEADER) + "\n"):
            raise SystemExit("%s: header does not match; not appending to a file we cannot read back" % path)
        f.write("\t".join(row[h] for h in HEADER) + "\n")
        f.flush()
        os.fsync(f.fileno())


def resolve_content(a):
    """Return (bytes to install, full commit sha, source repo name)."""
    if a.template and not is_template(a.src):
        raise SystemExit("--template needs --src to name the .example it was filled from")
    if not a.template and is_template(a.src):
        raise SystemExit("%s is a template; install the filled copy with --file and --template" % a.src)
    if a.repo:
        repo = os.path.abspath(a.repo)
        commit = git(repo, "rev-parse", "--verify", a.commit + "^{commit}").decode().strip()
        blob = git(repo, "show", "%s:%s" % (commit, a.src))
        name = a.source_repo or repo_name(repo)
        if not a.file:
            if a.template:
                raise SystemExit("--template needs --file: the filled copy is what gets installed")
            return blob, commit, name
        with open(a.file, "rb") as f:
            content = f.read()
        if not a.template and content != blob:
            raise SystemExit("--file differs from %s:%s" % (commit[:12], a.src))
        return content, commit, name
    if not (a.file and a.source_repo):
        raise SystemExit("without --repo, pass --file and --source-repo")
    if not (len(a.commit) == 40 and HEX.match(a.commit)):
        raise SystemExit("without --repo the commit cannot be resolved here; pass the full 40-hex sha")
    with open(a.file, "rb") as f:
        content = f.read()
    if not a.template:
        if not a.blob_md5:
            raise SystemExit("without --repo, --blob-md5 is what proves these are the blob's bytes")
        if md5_bytes(content) != a.blob_md5:
            raise SystemExit("--file is %s, not the blob's %s" % (md5_bytes(content), a.blob_md5))
    return content, a.commit, a.source_repo


def deployed_by():
    return os.environ.get("KTP_DEPLOYED_BY") or "%s@%s" % (os.environ.get("SUDO_USER") or getpass.getuser(),
                                                           socket.gethostname())


def last_row_for(path, manifest):
    """The path's last manifest row, or None. Raises if the manifest exists and does not parse."""
    if not os.path.exists(manifest):
        return None
    rows = read_manifest(manifest)
    for row in reversed(rows):
        if row["installed_path"] == path:
            return row
    return None


def record_only(a):
    """Record that the file already at --dest IS the blob at --commit, copying nothing.

    The whole value of this mode is that it cannot record a claim it did not
    check, so every path in here ends either at a verified row or at a refusal.
    It hashes the bytes on disk and compares them to the blob before the row is
    written; a caller's assertion is never the evidence.
    """
    if a.template:
        raise SystemExit("--record-only cannot check a filled template: its bytes cannot equal any blob, "
                         "so the row would rest on your word. Install it with --template instead.")
    if not a.repo:
        raise SystemExit("--record-only needs --repo: without the blob here there is nothing to compare "
                         "the file against, and an unchecked row is the drift it is meant to clear")
    if a.file:
        raise SystemExit("--record-only records the file already at --dest and copies nothing; --file "
                         "would name a second file that is not the one being recorded")
    if a.blob_md5:
        raise SystemExit("--record-only takes the blob from --repo; --blob-md5 would restate it as a claim")
    if a.mode is not None:
        raise SystemExit("--record-only writes no file, so --mode would change nothing")

    repo = os.path.abspath(a.repo)
    commit = git(repo, "rev-parse", "--verify", a.commit + "^{commit}").decode().strip()
    blob = git(repo, "show", "%s:%s" % (commit, a.src))
    blob_md5 = md5_bytes(blob)
    source_repo = a.source_repo or repo_name(repo)

    dest = os.path.abspath(a.dest)
    current = md5_file(dest)
    if current == "-":
        raise SystemExit("%s does not exist; there is nothing installed to record" % dest)
    if a.expect_md5 is not None and current != a.expect_md5:
        raise SystemExit("%s is %s, expected %s; not recording it" % (dest, current, a.expect_md5))
    if current != blob_md5:
        raise SystemExit("%s is %s, but %s@%s:%s is %s; refusing to record a file that is not that blob"
                         % (dest, current, source_repo, commit[:12], a.src, blob_md5))

    manifest = manifest_for_writes()
    try:
        previous = last_row_for(dest, manifest)
    except ManifestError as e:
        raise SystemExit("%s; not recording into a manifest we cannot read back" % e)
    if previous and (previous["md5"], previous["source_commit"], previous["source_path"],
                     previous["source_repo"]) == (current, commit, a.src, source_repo):
        raise SystemExit("%s is already recorded as %s@%s:%s; nothing to record"
                         % (dest, source_repo, commit[:12], a.src))

    # previous_md5 == md5 is what marks a row as recorded rather than installed:
    # the install path refuses a no-op, so it can never write one.
    append_row({
        "installed_path": dest,
        "md5": current,
        "source_repo": source_repo,
        "source_commit": commit,
        "source_path": a.src,
        "deployed_at_iso": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "previous_md5": current,
        "deployed_by": deployed_by(),
    }, manifest)
    print("recorded %s  %s  is %s@%s:%s  (nothing copied; recorded in %s)"
          % (dest, current, source_repo, commit[:12], a.src, manifest))


def install(a):
    content, commit, source_repo = resolve_content(a)
    new_md5 = md5_bytes(content)

    current = md5_file(a.dest)
    if current != a.expect_md5:
        raise SystemExit("%s is %s, expected %s; not touching it" % (a.dest, current, a.expect_md5))
    if current == new_md5:
        raise SystemExit("%s already has md5 %s; nothing to install" % (a.dest, new_md5))

    mode = a.mode
    owner = None
    if current != "-":
        st = os.stat(a.dest)
        mode = mode if mode is not None else (st.st_mode & 0o7777)
        owner = (st.st_uid, st.st_gid)
        bdir = backup_dir()
        os.makedirs(bdir, exist_ok=True)
        bk = os.path.join(bdir, "%s.%s.%s" % (os.path.basename(a.dest), current[:8],
                                              time.strftime("%Y%m%dT%H%M%S")))
        with open(a.dest, "rb") as src, open(bk, "wb") as dst:
            dst.write(src.read())
        if md5_file(bk) != current:
            raise SystemExit("backup %s does not match the file it copies" % bk)
    elif mode is None:
        mode = 0o755

    tmp = a.dest + ".new"
    with open(tmp, "wb") as f:
        f.write(content)
        f.flush()
        os.fsync(f.fileno())
    os.chmod(tmp, mode)
    # The swap writes a new inode, so the mode has to be re-applied -- and so does the owner,
    # which carrying only the mode silently drops. A 750 file owned by a service account came
    # back root:root with its mode intact, and 750 then gave that account nothing.
    if owner is not None and owner != (os.geteuid(), os.getegid()):
        try:
            os.chown(tmp, owner[0], owner[1])
        except OSError as e:
            os.unlink(tmp)
            raise SystemExit("cannot preserve %s's owner %d:%d (%s); refusing rather than "
                             "installing a file its own service cannot read"
                             % (a.dest, owner[0], owner[1], e.strerror))
    if md5_file(tmp) != new_md5:
        os.unlink(tmp)
        raise SystemExit("%s did not write back as %s" % (tmp, new_md5))
    if md5_file(a.dest) != current:
        os.unlink(tmp)
        raise SystemExit("%s changed while installing; not swapping" % a.dest)
    os.replace(tmp, a.dest)
    if md5_file(a.dest) != new_md5:
        raise SystemExit("%s does not read back as %s after the swap" % (a.dest, new_md5))

    who = deployed_by()
    manifest = manifest_for_writes()
    append_row({
        "installed_path": os.path.abspath(a.dest),
        "md5": new_md5,
        "source_repo": source_repo,
        "source_commit": commit,
        "source_path": a.src,
        "deployed_at_iso": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
        "previous_md5": current,
        "deployed_by": who,
    }, manifest)
    print("installed %s  %s -> %s  from %s@%s:%s%s  (recorded in %s)"
          % (a.dest, current, new_md5, source_repo, commit[:12], a.src,
             " [templated]" if a.template else "", manifest))


FRESH_OK = ("OK", "TEMPLATED", "CURRENT", "OTHER-REPO")


def blob_at(repo, ref, path):
    """(md5, present). present=False when ref does not hold that path at all."""
    p = subprocess.run(["git", "-C", repo, "show", "%s:%s" % (ref, path)], capture_output=True)
    if p.returncode != 0:
        return None, False
    return md5_bytes(p.stdout), True


def baseline(a):
    """(ref_commit, this_repo, how) for --against-ref. Untrusted when it cannot be established."""
    if not a.repo:
        raise Untrusted("--against-ref needs --repo: the ref is resolved there")
    p = subprocess.run(["git", "-C", a.repo, "rev-parse", "--verify", a.against_ref + "^{commit}"],
                       capture_output=True)
    if p.returncode != 0:
        raise Untrusted("%s does not resolve in %s" % (a.against_ref, a.repo))
    ref_commit = p.stdout.decode().strip()
    return ref_commit, repo_name(a.repo), settle_baseline(a.repo, a.against_ref, ref_commit)


def classify(a, r, path, ref_commit, this_repo):
    """(state, extra, ref_md5, installed_md5) for one row.

    The file is hashed once and that hash is returned, so the state and the md5 a
    caller prints beside it can never come from two different reads.
    """
    now = md5_file(path)
    if now == "-":
        state = "MISSING"
    elif now != r["md5"]:
        state = "DRIFT"
    else:
        state = "TEMPLATED" if is_template(r["source_path"]) else "OK"
    extra = ""
    ref_md5 = None
    if a.repo and state in ("OK", "TEMPLATED"):
        # A commit this checkout does not carry cannot indict the row. Shallow
        # clones and rows from other repos both land here, and calling either
        # SOURCE-MISMATCH turns "I cannot check" into "it is wrong".
        have = subprocess.run(["git", "-C", a.repo, "cat-file", "-e", r["source_commit"] + "^{commit}"],
                              capture_output=True)
        if have.returncode != 0:
            extra = "  (recorded commit not in this checkout; provenance not compared)"
        else:
            p = subprocess.run(["git", "-C", a.repo, "show", "%s:%s" % (r["source_commit"], r["source_path"])],
                               capture_output=True)
            if p.returncode != 0:
                state, extra = "SOURCE-MISMATCH", "  (recorded commit has no such path)"
            elif state == "OK" and md5_bytes(p.stdout) != r["md5"]:
                state, extra = "SOURCE-MISMATCH", "  (recorded commit does not hold these bytes)"
    if ref_commit and state in ("OK", "TEMPLATED"):
        # Row names its repo as a bare name or owner/name; compare the tail.
        if r["source_repo"].rsplit("/", 1)[-1] != this_repo:
            state, extra = "OTHER-REPO", "  (not %s; freshness not compared)" % this_repo
        elif state == "TEMPLATED":
            extra = "  (filled template; its bytes cannot equal any blob)"
        else:
            want, present = blob_at(a.repo, ref_commit, r["source_path"])
            if not present:
                state = "SOURCE-GONE"
                extra = "  (%s no longer holds %s)" % (a.against_ref, r["source_path"])
            elif want != r["md5"]:
                state = "STALE"
                ref_md5 = want
                extra = "  (%s holds %s, installed %s)" % (a.against_ref, want[:12],
                                                           r["source_commit"][:12])
            else:
                state = "CURRENT"
                ref_md5 = want
    return state, extra, ref_md5, now


def last_rows():
    """Every manifest that applies here, collapsed to each path's last row. Untrusted on any doubt."""
    paths = [p for p in manifests_for_report() if os.path.exists(p)]
    if not paths:
        raise Untrusted("no manifest at %s" % " or ".join(manifests_for_report()))
    last = {}
    for mp in paths:
        try:
            rows = read_manifest(mp)
        except ManifestError as e:
            raise Untrusted(str(e))
        if not rows:
            raise Untrusted("%s has a header and no rows" % mp)
        for r in rows:
            last[r["installed_path"]] = r
    return last


def report(a):
    ref_commit = this_repo = None
    if a.against_ref:
        try:
            ref_commit, this_repo, how = baseline(a)
        except Untrusted as e:
            print("UNTRUSTED  %s" % e)
            return 2
        # First line, and it is the point of the whole report: a CURRENT below is only
        # as good as what it was compared to, so the output says what that was and how
        # we know. ⚠️ It is not a row -- a parser keying on the state token must skip it.
        print("baseline        %s  %s  (%s)" % (a.against_ref, ref_commit, how))

    try:
        last = last_rows()
    except Untrusted as e:
        print("UNTRUSTED  %s" % e)
        return 2
    bad = 0
    for path in sorted(last):
        r = last[path]
        state, extra, _, now = classify(a, r, path, ref_commit, this_repo)
        if state not in FRESH_OK:
            bad += 1
        print("%-15s %s  %s  %s@%s:%s%s" % (state, path, now, r["source_repo"],
                                            r["source_commit"][:12], r["source_path"], extra))
    return 1 if bad else 0


def _stage_name(stage_dir, dest):
    """A stage path per destination, so two files sharing a basename cannot collide."""
    return os.path.join(stage_dir, dest.lstrip("/").replace("/", "_"))


def plan(a):
    """Emit the install commands that would bring every STALE row up to REF.

    This is the deploy step the estate has never had -- not because a puller is hard
    but because nothing could say WHAT is owed. /usr/local/bin is installed by a
    person remembering to copy a file, and the commands were written out by hand
    each time, which is where the mistakes were: one deploy packet named a PR's
    merge sha as --commit rather than the ref the freshness guard would compare
    against, which refuses on every later run.

    It writes nothing. Every command it emits is pinned twice to bytes measured in
    this run -- --expect-md5 to what is on the box, --blob-md5 to what REF holds --
    so a plan that has gone out of date refuses instead of clobbering, and one
    staged out of the wrong tree refuses too. It can go stale; it cannot install the
    wrong thing.

    It is reachable only through a baseline that was checked against its remote, so
    it cannot emit a plan that installs stale bytes as though they were current.
    That ordering is the whole point: the gate is what makes the step safe to
    generate.

    Exit 0 nothing owed, 1 a plan was emitted, 2 untrusted. 1 is the productive
    outcome here, which inverts the usual reading -- and never pipe it, because a
    pipeline reports the last command's status.
    """
    try:
        ref_commit, this_repo, how = baseline(a)
        last = last_rows()
    except Untrusted as e:
        print("UNTRUSTED  %s" % e)
        return 2

    stage = a.stage_dir or os.path.join(os.path.expanduser("~"), ".ktp", "stage")
    repo = os.path.abspath(a.repo)
    todo, refused = [], []
    for path in sorted(last):
        r = last[path]
        state, extra, ref_md5, now = classify(a, r, path, ref_commit, this_repo)
        if state == "STALE":
            todo.append((path, r, ref_md5, now))
        elif state not in FRESH_OK:
            refused.append((path, state, extra.strip() or "-"))

    q = shlex.quote
    print("# ktp-install plan  %s  %s" % (socket.gethostname(), time.strftime("%Y-%m-%dT%H:%M:%S%z")))
    print("# baseline %s  %s  (%s)" % (a.against_ref, ref_commit, how))
    print("#")
    print("# Generated rather than written out by hand, and it writes nothing itself. Every")
    print("# command below is pinned twice to bytes measured just now:")
    print("#   --expect-md5  what is on this box, so a plan gone stale REFUSES instead of clobbering")
    print("#   --blob-md5    what %s holds, so a file staged from the wrong tree REFUSES too" % a.against_ref)
    print("# A plan can go out of date. It cannot install the wrong thing.")
    print("#")
    print("# The git show reads %s at a SHA, not at a branch, so how stale that tree's refs are" % repo)
    print("# does not matter: those bytes either hash to --blob-md5 or the install refuses.")
    print("#")
    print("# NOT A DEPENDENCY ORDER. This is the manifest's order. An import-level dependency")
    print("#   between two of these files is not derivable here, and one is known --")
    print("#   ktp-verify-deploy imports ktp_script_freshness at module level, so the guard")
    print("#   installs first. docs/runbooks/INSTALL_FRESHNESS.md carries the ones we know.")
    print("# RECORDED ESTATE ONLY. A file nobody installed with ktp-install is in no manifest and")
    print("#   cannot be stale here; docs/LIVE_SCRIPT_INVENTORY.md is that half.")
    print("")
    if not todo:
        print("# nothing owed: no recorded path is behind %s" % a.against_ref)
        print("")
    else:
        print("mkdir -p %s" % q(stage))
        print("")
    for path, r, ref_md5, now in todo:
        src = r["source_path"]
        stage_file = _stage_name(stage, path)
        print("# %s  STALE  (installed %s from %s; %s holds %s)"
              % (path, now[:12], r["source_commit"][:12], a.against_ref, ref_md5[:12]))
        print("git -C %s show %s:%s > %s" % (q(repo), ref_commit, q(src), q(stage_file)))
        print("ktp-install --file %s --source-repo %s --commit %s \\"
              % (q(stage_file), q(r["source_repo"]), ref_commit))
        print("            --src %s --dest %s \\" % (q(src), q(path)))
        print("            --expect-md5 %s --blob-md5 %s" % (now, ref_md5))
        print("")
    if refused:
        print("# NOT PLANNED -- each needs a decision a generator must not make for you:")
        for path, state, why in refused:
            print("#   %-15s %s  %s" % (state, path, why))
        print("")
    return 1 if todo else 0


def main(argv=None):
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--report", action="store_true")
    ap.add_argument("--repo")
    ap.add_argument("--commit")
    ap.add_argument("--src")
    ap.add_argument("--dest")
    ap.add_argument("--file")
    ap.add_argument("--template", action="store_true")
    ap.add_argument("--blob-md5")
    ap.add_argument("--expect-md5")
    ap.add_argument("--mode", type=lambda s: int(s, 8))
    ap.add_argument("--source-repo")
    ap.add_argument("--against-ref",
                    help="with --report --repo: compare installed bytes to this ref, "
                         "not just to the row they were installed from")
    ap.add_argument("--record-only", action="store_true",
                    help="record that the file already at --dest is the blob at --commit, copying "
                         "nothing; refuses unless the bytes on disk are that blob")
    ap.add_argument("--plan", action="store_true",
                    help="with --repo --against-ref: print the install commands that would bring "
                         "every STALE row up to that ref, and write nothing")
    ap.add_argument("--stage-dir",
                    help="with --plan: where the plan stages blobs (default ~/.ktp/stage)")
    a = ap.parse_args(argv)
    if a.plan:
        for other in ("report", "record_only"):
            if getattr(a, other):
                ap.error("--plan and --%s are different jobs; run them separately"
                         % other.replace("_", "-"))
        if not a.against_ref:
            ap.error("--plan needs --against-ref: a plan is what the gap to a ref IS, and without "
                     "one there is nothing to be behind")
        return plan(a)
    if a.stage_dir:
        ap.error("--stage-dir is a --plan flag")
    if a.report:
        if a.record_only:
            ap.error("--report and --record-only are different jobs; run them separately")
        return report(a)
    if a.against_ref:
        ap.error("--against-ref is a --report flag (and a --plan flag); an install or a record "
                 "already names its commit")
    if a.record_only:
        missing = [n for n in ("commit", "src", "dest") if getattr(a, n) is None]
        if missing:
            ap.error("--record-only needs --" + ", --".join(m.replace("_", "-") for m in missing))
        record_only(a)
        return 0
    missing = [n for n in ("commit", "src", "dest", "expect_md5") if getattr(a, n) is None]
    if missing:
        ap.error("install needs --" + ", --".join(m.replace("_", "-") for m in missing))
    # Only the install path copies bytes, so only it is refused: --report reads that tree on
    # purpose, and --record-only verifies bytes already on disk rather than sourcing new ones.
    refuse_stale_source(ap, a.repo)
    install(a)
    return 0


if __name__ == "__main__":
    sys.exit(main())

[Unit]
Description=Run the KTP own-weapon kill report nightly, after the 03:00 ET fleet swap and the evening's matches
Documentation=https://github.com/afraznein/KTPInfrastructure

[Timer]
# 06:15 local: after the swap and the report pipeline, five minutes behind voice taunts so the
# two nightly reads of hlstatsx do not overlap. Persistent so a box that was down runs it on boot.
OnCalendar=*-*-* 06:15:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target

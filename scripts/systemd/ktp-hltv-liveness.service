[Unit]
Description=KTP HLTV proxy liveness check (port-bound, not systemd unit state)
Documentation=https://github.com/afraznein/KTPInfrastructure

[Service]
Type=oneshot
ExecStart=/usr/local/bin/ktp-hltv-liveness.sh
# Type=oneshot disables the start timeout by default, so a wedged run sits in
# `activating`: the timer never re-fires, `systemctl --failed` cannot see it, and
# OnFailure= needs an exit. A backstop only, and it kills without explaining —
# the script's own bounds are sized to fire first and say what happened.
TimeoutStartSec=4min
# exit 1 = proxies missing, exit 2 = probe broken. Both are reported by the
# script itself; do not let systemd mark the unit failed and stop the timer.
# exit 4 is withheld on purpose: the script detected a fault and could NOT report
# it, so a failed unit is the only surface left.
SuccessExitStatus=0 1 2

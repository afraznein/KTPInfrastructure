# /etc/ktp/install-freshness.conf — sourced by ktp-install-freshness.sh.
# Copy, fill, chmod 600, root:root. Every value here has a working default in
# the script; this file exists for the two that are host decisions.

# The checkout AGAINST_REF is resolved in. The check runs `git fetch` here with
# an explicit refspec that writes only refs/remotes/<remote>/<branch>, and exits 1
# if HEAD moved, so the working tree is never checked out, merged or pulled.
#FRESHNESS_REPO="/opt/ktp-infra"

# What "current" means, as <remote>/<branch> -- a remote-tracking ref, because
# that is what the fetch refreshes. origin/main is the merged tree.
#AGAINST_REF="origin/main"

# Channel fallback, used only until an operator maps the ops-daily lane in
# /etc/ktp/discord-relay.conf. Unmapped and unset, the script exits 2 rather
# than guessing an id. No id is written into this repo; it is public.
#ALERT_CHANNEL=""

# How long a gap counts as "did not run". Default 172800 (two daily intervals).
#MAX_GAP_SEC=172800

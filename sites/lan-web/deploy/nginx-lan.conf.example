# Reverse-proxy the LAN web service.
#
# ⚠️ CORRECTED 2026-08-14. This file described a /lan/ sub-path deployment with
# LAN_WEB_ROOT_PATH=/lan. Production has not run that way since the site moved to
# its own domain: LAN_WEB_ROOT_PATH is EMPTY, nginx has a single `location /`,
# and /lan/admin 404s. Provisioning a new box from the old shape also registered
# the wrong Discord redirect URI, so OAuth failed rather than merely serving on
# an odd path.
#
# Live shape (dodworldseries.com), for a host with its own domain:

server {
    server_name YOUR_HOST;
    client_max_body_size 300M;          # photo and demo uploads

    location / {
        proxy_pass http://127.0.0.1:8099;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # TLS: certbot writes the listen/ssl_certificate lines in place.
}

# Discord OAuth redirect URI must match DISCORD_REDIRECT_URI exactly:
#   https://YOUR_HOST/auth/callback
#
# The app serves the built static site itself (LAN_SITE_DIR, LAN_SITE_AT_ROOT=1)
# from a mount at "/" registered AFTER every router — Mount("/") matches every
# path, so nginx must not try to serve those files, and a router added after the
# mount would never be reached. One origin for the site, the API and OAuth is
# what keeps the session cookie and the redirect URI singular.
#
# ---------------------------------------------------------------------------
# If you genuinely need a sub-path (no domain of its own), set
# LAN_WEB_ROOT_PATH=/lan, point DISCORD_REDIRECT_URI at /lan/auth/callback, and:
#
#   location /lan/ { proxy_pass http://127.0.0.1:8099; ...same headers... }
#   location = /lan { return 301 /lan/; }
#
# ⚠️ NO trailing slash on proxy_pass. The app serves every route and its static
# mount under the prefix, so the full /lan/... path must arrive unchanged. A
# trailing slash strips the prefix and the dossier CSS 404s — the page renders
# unstyled rather than erroring. Learned the hard way on the first live deploy.

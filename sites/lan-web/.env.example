# WSDoD LAN 2026 web service — environment config.
# Copy to .env for local dev, or deploy as /etc/ktp/lan-web.env (see deploy/lan-web.service).

# --- App ---
LAN_WEB_ENV=dev                       # dev | prod  (prod sets Secure cookies)
LAN_WEB_SECRET_KEY=                   # session signing key; generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
LAN_WEB_BASE_URL=http://127.0.0.1:8099
LAN_WEB_BIND_HOST=127.0.0.1
LAN_WEB_BIND_PORT=8099
LAN_WEB_ROOT_PATH=                    # leave empty in dev; set to /lan when served behind nginx at /lan/

# --- Discord OAuth ---
# Create an app at https://discord.com/developers/applications
#   OAuth2 → add redirect: https://YOUR_DOMAIN/lan/auth/callback  (dev: http://127.0.0.1:8099/auth/callback)
#   Scopes used: identify
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=                 # full public URL of the callback; must match the Discord app exactly

# Comma/space-separated Discord IDs allowed to run staff controls (open/close/compute poll, etc.)
LAN_ADMIN_DISCORD_IDS=

# --- Discord notifications (both optional; unset = that feature silently no-ops) ---
# Bot token for captain DMs ("you're up on Server 3"). The bot must share a guild
# with the captains — KTPAdminBot's already does.
LAN_DISCORD_BOT_TOKEN=
# Channel webhook that site-wide announcements cross-post to.
# Discord: Channel → Edit Channel → Integrations → Webhooks → New Webhook → Copy URL.
# TREAT AS A SECRET — anyone holding this URL can post to the channel. Never commit a real one.
LAN_DISCORD_WEBHOOK_URL=
# Role pinged by those cross-posts. Defaults to the WSDoD announce role; set empty for no ping.
LAN_DISCORD_ANNOUNCE_ROLE_ID=1343215543175352392

# --- KTP Discord Relay (photo removal requests + site feedback; optional — unset = no Discord post) ---
# Full relay endpoint INCLUDING its /reply path — the app posts to it verbatim and
# appending /reply again 404s. The relay bot must be able to see the target channel.
LAN_DISCORD_RELAY_URL=
# Shared secret sent as the X-Relay-Auth header.
# TREAT AS A SECRET — anyone holding it can post as the relay. Never commit a real one.
LAN_DISCORD_RELAY_AUTH=
# Channel the takedown requests land in, and the staff member pinged on each one.
# The ping is the only mention that can fire: requester text is posted with parse:[].
LAN_PHOTO_REPORT_CHANNEL_ID=1535106233877663744
LAN_PHOTO_REPORT_PING_USER_ID=218890328273321984
# Where site feedback lands. Same channel by default, but deliberately its own
# setting — and feedback posts carry no ping, so it can be split off without
# turning takedown pings off with it.
LAN_FEEDBACK_CHANNEL_ID=1535106233877663744

# --- Database (dedicated LAN DB on the existing MySQL server) ---
# One-time setup as MySQL root:
#   CREATE DATABASE ktp_lan CHARACTER SET utf8mb4;
#   CREATE USER 'ktp_lan'@'localhost' IDENTIFIED BY '<pick-a-password>';
#   GRANT ALL PRIVILEGES ON ktp_lan.* TO 'ktp_lan'@'localhost';
#   FLUSH PRIVILEGES;
LAN_DB_HOST=127.0.0.1
LAN_DB_PORT=3306
LAN_DB_USER=ktp_lan
LAN_DB_PASSWORD=
LAN_DB_NAME=ktp_lan

# --- Demo archive ---
# Where uploaded (zipped) demos are stored. Keep it OUTSIDE /opt/lan-web so a
# code redeploy (cp -a) never wipes uploads. Prod: /var/lib/lan-web/demos
LAN_DEMO_DIR=
LAN_DEMO_MAX_MB=250

# --- Photo gallery ---
# Same rule as the demo archive: keep it outside /opt/lan-web so a redeploy can't wipe it.
LAN_PHOTO_DIR=
LAN_PHOTO_MAX_MB=15
